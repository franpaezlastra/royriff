# API Roy Riff (backend propio). Las credenciales de WooCommerce están SOLO en el backend.
# En desarrollo no hace falta si el proxy de Vite apunta a localhost:4000.
VITE_API_URL=

# URL pública de la tienda WooCommerce (solo para redirección al checkout). No es una credencial.
VITE_STORE_URL=https://api.royriff.com.ar

# URLs del frontend (para links de retorno/cancelación en órdenes)
VITE_FRONTEND_URL=https://react.royriff.com.ar

# Site (opcional)
VITE_SITE_NAME=Roy Riff
VITE_SITE_URL=https://royriff.com
